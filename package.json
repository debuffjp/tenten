{
  "name": "@debuffjp/tenten",
  "publishConfig": { "access": "public" },
  "version": "0.0.1",
  "description": "tenten: a headless pixel-art and animation tool for coding agents. Indexed sprites, frames, tags and slices over an MCP server and a CLI, with text renders in every result. Imports and exports .aseprite.",
  "repository": { "type": "git", "url": "git+https://github.com/debuffjp/tenten.git" },
  "homepage": "https://github.com/debuffjp/tenten",
  "keywords": ["pixel-art", "sprites", "aseprite", "mcp", "debuff", "gamedev"],
  "type": "module",
  "license": "MIT",
  "bin": {
    "tenten": "bin/tenten.js",
    "tenten-mcp": "bin/tenten-mcp.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "mcp": "node bin/tenten-mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "fast-png": "8.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "files": ["bin", "src", "docs/brand"]
}
