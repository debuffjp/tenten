{
  "name": "@debuffjp/tenten",
  "publishConfig": { "access": "public" },
  "version": "0.0.2",
  "description": "tenten: a headless, scriptable pixel-art and animation tool. Indexed sprites, frames, tags and slices drawn as text grids and ops over an MCP server, a CLI and a TypeScript API, with a text render in every result. Imports and exports .aseprite.",
  "repository": { "type": "git", "url": "git+https://github.com/debuffjp/tenten.git" },
  "homepage": "https://github.com/debuffjp/tenten",
  "keywords": ["pixel-art", "sprites", "aseprite", "mcp", "debuff", "gamedev"],
  "type": "module",
  "license": "MIT",
  "bin": {
    "tenten": "bin/tenten.js",
    "tenten-mcp": "bin/tenten-mcp.js"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run check && npm run build",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "mcp": "node bin/tenten-mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "fast-png": "8.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "files": ["bin", "dist", "docs/brand"]
}
